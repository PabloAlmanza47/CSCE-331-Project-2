[Location]
    *location_id
    name
    city
    state

[Receipt]
    *receipt_id
    +location_id
    +user_id
    timestamp

[ReceiptItem]
    *receipt_item_id
    +receipt_id
    +item_id
    quantity
    price_at_sale

[Item]
    *item_id
    +category_id
    nutrition
    price
    unit_size
    name

[Inventory]
    *Inventory_id
    name
    nutrition
    stock
    next_shipment
    shelf_life
    unit_size

[IngredientList]
    +item_id
    +inventory_id

[Category]
    *category_id
    name
    allergy_info

[User]
    *user_id
    password
    perms
    

[UserTimetable]
    *timetable_id
    +user_id
    +location_id
    clock_in_time
    clock_out_time

# Relationships
Receipt 1--* ReceiptItem
Item 1--* ReceiptItem
Location 1--* Receipt 
Category 1--* Item 
User 1--* Receipt
Location 1--* User
User 1--* UserTimetable