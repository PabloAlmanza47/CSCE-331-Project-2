erDiagram
    LOCATION {
        int location_id PK
        string name
        string city
        string state
    }

    RECEIPT {
        int receipt_id PK
        int location_id FK
        int user_id FK
        datetime timestamp
    }

    RECEIPT_ITEM {
        int receipt_item_id PK
        int receipt_id FK
        int item_id FK
        int quantity
        decimal price_at_sale
    }

    ITEM {
        int item_id PK
        int category_id FK
        string nutrition
        decimal price
        string unit_size
        string name
    }

    INVENTORY {
        int inventory_id PK
        string name
        string nutrition
        int stock
        int min_stock
        datetime next_shipment
        datetime shelf_life
        float unit_size
    }

    INGREDIENT_LIST {
        int item_id FK
        int inventory_id FK
    }

    CATEGORY {
        int category_id PK
        string name
        string allergy_info
    }

    USER {
        int user_id PK
        string name
        string password
        user_perm perms
    }

    USER_TIMETABLE {
        int timetable_id PK
        int user_id FK
        int location_id FK
        datetime clock_in_time
        datetime clock_out_time
    }

    RECEIPT ||--o{ RECEIPT_ITEM : contains
    ITEM ||--o{ RECEIPT_ITEM : appears_on
    LOCATION ||--o{ RECEIPT : has
    CATEGORY ||--o{ ITEM : contains
    USER ||--o{ RECEIPT : creates
    USER ||--o{ USER_TIMETABLE : creates
    INGREDIENT_LIST ||--o{ INVENTORY : has
    INGREDIENT_LIST ||--o{ ITEM : has
