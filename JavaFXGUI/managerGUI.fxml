<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_LEFT" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="managerController">
<HBox alignment="TOP_LEFT" prefHeight="800.0" prefWidth="1200.0" VBox.vgrow="ALWAYS">
<TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
  <tabs>
    <!-- Item Sold Tab (Bar Graph) -->
    <Tab text="Items Sold"><content>
      <AnchorPane styleClass="genericStyle" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
        <children>
          <Button fx:id="changeViewButton1" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#changeView" styleClass="genericStyle" text="Change View" />
          <Button fx:id="closeButton1" layoutX="110.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeWindow" styleClass="genericStyle" text="Close App" />
          <BarChart fx:id="salesGraph" layoutX="14.0" layoutY="43.0" legendVisible="false" prefHeight="314.0" prefWidth="573.0" title="Items Sold">
            <xAxis>
              <NumberAxis label="Number Sold" tickLabelRotation="0.01" />
            </xAxis>
            <yAxis>
              <CategoryAxis label="Item Name" side="LEFT" />
            </yAxis>
            <AnchorPane.topAnchor>57.0</AnchorPane.topAnchor>
            <AnchorPane.leftAnchor>14.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>14.0</AnchorPane.rightAnchor>
            <AnchorPane.bottomAnchor>14.0</AnchorPane.bottomAnchor>
          </BarChart>
        </children>
      </AnchorPane>
    </content></Tab>

    <!-- Stock Tab -->
    <Tab text="Stock"><content>
      <AnchorPane styleClass="genericStyle" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
        <children>
          <Button fx:id="changeViewButton2" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#changeView" styleClass="genericStyle" text="Change View" />
          <Button fx:id="closeButton2" layoutX="110.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeWindow" styleClass="genericStyle" text="Close App" />
            <ListView fx:id="stockListView" layoutX="14.0" layoutY="49.0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
              <AnchorPane.topAnchor>63.0</AnchorPane.topAnchor>
              <AnchorPane.leftAnchor>14.0</AnchorPane.leftAnchor>
              <AnchorPane.rightAnchor>14.0</AnchorPane.rightAnchor>
              <AnchorPane.bottomAnchor>14.0</AnchorPane.bottomAnchor>
            </ListView>
        </children>
      </AnchorPane> 
    </content></Tab>

      <!-- Order History (Receipts) Tab -->
      <Tab text="Order History"><content>
        <AnchorPane styleClass="genericStyle" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
          <children>
            <Button fx:id="changeViewButton3" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#changeView" styleClass="genericStyle" text="Change View" />
            <Button fx:id="closeButton3" layoutX="110.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeWindow" styleClass="genericStyle" text="Close App" />
                  <ScrollPane fitToWidth="true" fitToHeight="true"
                    AnchorPane.topAnchor="60.0"
                    AnchorPane.leftAnchor="14.0"
                    AnchorPane.rightAnchor="14.0"
                    AnchorPane.bottomAnchor="14.0">
                    <content>
                      <VBox fillWidth="true">
                        <children>
                          <Accordion fx:id="receiptAccordion" VBox.vgrow="ALWAYS" />
                        </children>
                      </VBox>
                    </content>
                  </ScrollPane>
          </children>
        </AnchorPane>
      </content></Tab>

      <!-- Menu Tab -->
    <Tab text="Menu"><content>
      <AnchorPane styleClass="genericStyle" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
        <children>
          <Button fx:id="changeViewButton4" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#changeView" styleClass="genericStyle" text="Change View" />
          <Button fx:id="closeButton4" layoutX="110.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeWindow" styleClass="genericStyle" text="Close App" />
          <Button fx:id="addItem" layoutX="206.0" layoutY="14.0" mnemonicParsing="false" onAction="#addMenuItem" styleClass="genericStyle" text="Add Menu Item" />
            <ListView fx:id="menuListView" layoutX="14.0" layoutY="49.0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
              <AnchorPane.topAnchor>63.0</AnchorPane.topAnchor>
              <AnchorPane.leftAnchor>14.0</AnchorPane.leftAnchor>
              <AnchorPane.rightAnchor>14.0</AnchorPane.rightAnchor>
              <AnchorPane.bottomAnchor>14.0</AnchorPane.bottomAnchor>
            </ListView>
        </children>
      </AnchorPane> 
    </content></Tab>

  </tabs>
</TabPane>
</HBox>
</VBox>
