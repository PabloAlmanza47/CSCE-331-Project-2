<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="520.0" prefWidth="695.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DatabaseController">
   <children>
      <Button fx:id="queryButton" mnemonicParsing="false" text="Display Vendors and Products" />
      <HBox alignment="CENTER" prefHeight="461.0" prefWidth="803.0" VBox.vgrow="ALWAYS">
         <children>
            <ScrollPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <content>
                  <VBox fx:id="mainBox" prefHeight="461.0" prefWidth="300.0" />
               </content>
            </ScrollPane>
            <ScrollPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <content>
                  <VBox fx:id="sideBox" prefHeight="461.0" prefWidth="300.0" />
               </content>
            </ScrollPane>
            <ScrollPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <content>
                  <VBox fx:id="drinkBox" prefHeight="461.0" prefWidth="300.0" />
               </content>
            </ScrollPane>
            <VBox fx:id="cartBox" prefHeight="461.0" prefWidth="274.0">
               <children>
                  <Button fx:id="checkout" mnemonicParsing="false" prefHeight="25.0" prefWidth="152.0" text="Checkout" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Button fx:id="closeButton" mnemonicParsing="false" text="Close" />
   </children>
</VBox>
